worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
events {worker_connections 1024;}
http {
 include /etc/nginx/mime.types;
 default_type application/octet-stream;
 access_log off;
 sendfile on;
 client_max_body_size 22m;
 # All writable Nginx scratch paths stay on the /tmp tmpfs. Never use
 # /var/cache/nginx here: its separate mount is root-owned at runtime.
 client_body_temp_path /tmp/nginx-temp/client_body;
 proxy_temp_path /tmp/nginx-temp/proxy;
 fastcgi_temp_path /tmp/nginx-temp/fastcgi;
 uwsgi_temp_path /tmp/nginx-temp/uwsgi;
 scgi_temp_path /tmp/nginx-temp/scgi;
 server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  add_header X-Content-Type-Options nosniff always;
  location = /healthz {default_type text/plain;return 200 'ok';}
  location /api/ {
   resolver 127.0.0.11 valid=10s ipv6=off;
   set $api_backend "api:8000";
   rewrite ^/api/(.*)$ /$1 break;
   proxy_pass http://$api_backend;
   proxy_set_header X-API-Key "${API_TOKEN}";
   proxy_set_header Host $host;
   proxy_read_timeout 180s;
   proxy_send_timeout 90s;
   proxy_buffering off;
   # Stream uploaded audio to the API instead of buffering large bodies to disk.
   proxy_request_buffering off;
  }
  location / {try_files $uri $uri/ /index.html;}
 }
}
