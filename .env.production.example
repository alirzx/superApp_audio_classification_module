APP_ENV=production
API_TOKEN=
API_BIND_IP=127.0.0.1
API_PORT=8007
UI_BIND_IP=192.168.4.209
UI_PORT=8088
MODEL_NAME=mn10_as
EXPECTED_MODEL_SHA256=
CPU_THREADS=2
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10
MAX_UPLOAD_MB=20
MAX_REQUEST_BYTES=23068672
MAX_DURATION_SECONDS=60
MAX_DECODE_BYTES=83886080
WINDOW_SECONDS=10
TOP_K=10
SCORE_THRESHOLD=0.10
ENABLE_METRICS=true
API_CPUS=2.0
API_MEMORY=1200m
UI_CPUS=0.5
UI_MEMORY=256m
SETUP_CPUS=1.0
SETUP_MEMORY=256m
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
NPM_REGISTRY_URL=https://package-mirror.liara.ir/repository/npm/
NPM_FALLBACK_REGISTRY_URL=https://registry.npmjs.org/
# Signed Debian APT (build-time; fallback when primary fails)
APT_PRIMARY_DEBIAN_URL=https://mirror.metanet.ch/debian
APT_PRIMARY_SECURITY_URL=https://mirror.metanet.ch/debian-security
APT_FALLBACK_DEBIAN_URL=https://mirrors.huaweicloud.com/repository/debian
APT_FALLBACK_SECURITY_URL=https://mirrors.huaweicloud.com/repository/debian-security
# Alpine APK for Nginx (build-time)
APK_PRIMARY_MIRROR_URL=https://linux-mirror.liara.ir/repository/alpine
APK_FALLBACK_MIRROR_URL=https://mirrors.huaweicloud.com/alpine
