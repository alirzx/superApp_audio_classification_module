# syntax=docker/dockerfile:1.6
FROM python:3.11-slim-bookworm
ARG PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
ARG PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
WORKDIR /srv
COPY backend/requirements-setup.txt /srv/requirements-setup.txt
RUN pip install --no-cache-dir --index-url "$PIP_PRIMARY_INDEX_URL" --extra-index-url "$PIP_FALLBACK_INDEX_URL" -r requirements-setup.txt
COPY backend/app /srv/app
COPY backend/scripts /srv/scripts
RUN useradd -r -u 10001 -d /srv runner && mkdir /models && chown runner:runner /models
USER runner
CMD ["python","-m","scripts.prepare_model"]
